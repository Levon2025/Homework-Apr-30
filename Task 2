		while(getchar() != '\n');
		str = (char *)malloc((size + 1)* sizeof(char));
		if(str == NULL){
				printf("No awelibale memory");
				return 1;				
		}
		printf("Enter the lane");
		fgets(str,size + 1,stdin);
