#include <stdio.h>
#include <stdlib.h>

int main(){
		float *arr;
		int n = 0;
		int i = 0;
		printf("Enter the count of elements");
		scanf("%d",&n);
		arr = (float*)calloc(n,sizeof(float));
		if(arr == NULL){
				printf("No avalible  space");
				return 1;
		}
		printf("Input the Elements%d\n" ,n);
		for(int i = 0; i < n ;i++){
				printf("arr[%d] = ",i);
				scanf("%f",&arr[i]);
		}
		printf("Elements of array");
		for(int i = 0; i < n ;i++){
				printf("%.2f",arr[i]);
		}
		printf("\n");
		free(arr);
		return 0;		
}
