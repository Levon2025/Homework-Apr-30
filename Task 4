#include <stdio.h>
#include <stdlib.h>

int main(){
		int *arr;
		int size = 0;
		int newsize = 0;
		int i = 0;
		printf("Enter the size of array");
		scanf("%d",&size);
		arr = (int*)malloc(size * sizeof(int));
		if(arr == NULL){
				printf("No space");
				return 1;				
		}
		printf("Input the Elements %d\n",size);
		for(int i = 0; i< size ; i++){
				printf("arr[%d]",i);
				scanf("%d",&arr[i]);
		}
		printf("New size of array");
		scanf("%d",&newsize);
		arr = (int*)realloc(arr,newsize * sizeof(int));
		if(arr == NULL){
				printf("Can't get that spasc");
				return 1;				
		}
		printf("New elemenst");
		for(int i = size ; i < newsize;i++){
				printf("arr[%d]",i);
				scanf("%d",&arr[i]);
		}
		printf("New size of array");
		for(int i = 0; i < newsize ; i++){
				printf("%d",arr[i]);				
		}
		printf("\n");
		free(arr);
		return 0;
}
