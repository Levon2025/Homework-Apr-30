#include <stdio.h>
#include <stdlib.h>

int main(){
		int *arr;
		int n = 0;
		int i = 0;

		printf("Enter the arr size");
		scanf("%d",&n);


		arr = (int*)malloc(n * sizeof(int));
		if(arr == NULL){
				printf("Can't get a memory");
				return 1;
		}
		printf("Input the elements %d\n:" ,n);
		for(int i = 0; i < n ; i++){
			printf("arr[%d] = ",i);
			scanf("%d",&arr[i]);			
		}
		printf("Array is ");
		for(i = 0; i < n ; i++){
			printf("%d",arr[i]);	
		}
		printf("\n");
		free(arr);
		return 0;
}
